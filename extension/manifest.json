{
  "manifest_version": 3,
  "name": "Skippy's Command Deck",
  "version": "0.3.1",
  "description": "Opens buildings, lots, ships and crews from Skippy's Command Deck in your open Influence game tab without reloading. Click the icon to jump back to the Command Deck.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://game.influenceth.io/*",
    "https://your-command.adalia.academy/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://your-command.adalia.academy/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Skippy's Command Deck – back to your Command Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}