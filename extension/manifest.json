{
  "manifest_version": 3,
  "name": "Skippy's Command Deck",
  "version": "0.4.5",
  "description": "Opens Command Deck links in your Influence game tab without a reload, adds an S button to the game, and keeps lot colours on.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://game.influenceth.io/*",
    "https://your-command.adalia.academy/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://your-command.adalia.academy/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "game.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "lotcolours.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Skippy's Command Deck – back to your Command Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://game.influenceth.io/*"
      ]
    }
  ]
}
