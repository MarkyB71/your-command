{
  "manifest_version": 3,
  "name": "Skippy's Command Deck",
  "version": "0.6.4",
  "description": "Links the Command Deck to your Influence game tab and adds helpers: status dots, food and propellant bars, map tags and markets.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://game.influenceth.io/*",
    "https://your-command.adalia.academy/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "r3fstore.js",
        "maptags.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://your-command.adalia.academy/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "game.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "lotcolours.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "statusdots.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "crewfood.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.influenceth.io/*"
      ],
      "js": [
        "shipprop.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Skippy's Command Deck – back to your Command Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://game.influenceth.io/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}